{
  "name": "mundo-da-bia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.domain.json",
    "lint": "eslint src",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "quality:fast": "node scripts/quality.mjs fast",
    "quality:ci": "node scripts/quality.mjs ci",
    "quality:mutation": "node scripts/quality.mjs mutation",
    "quality": "node scripts/quality.mjs all",
    "test:gates": "node scripts/test-gates.mjs",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
